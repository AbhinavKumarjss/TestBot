option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: Server/server.py
  aws:elasticbeanstalk:application:environment:
    PYTHONPATH: "/var/www/generalchatbot/Server"
    VIRTUAL_ENV: "/var/www/generalchatbot/Server/venv"

container_commands:
  01_install_requirements:
    command: |
      cd /var/www/generalchatbot/Server
      python3 -m venv venv
      source venv/bin/activate
      pip install --upgrade pip
      pip install -r requirements.txt
    ignoreErrors: false
  02_set_permissions:
    command: |
      chown -R webapp:webapp /var/www/generalchatbot/Server/venv
    ignoreErrors: false 