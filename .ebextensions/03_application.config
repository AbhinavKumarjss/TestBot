container_commands:
  01_setup_backend:
    command: |
      cd /var/app/staging/Server
      python3 -m venv venv
      source venv/bin/activate
      pip install --upgrade pip
      pip install -r requirements.txt
    ignoreErrors: false
  02_build_frontend:
    command: |
      cd /var/app/staging/Frontend
      npm install
      npm run build
    ignoreErrors: false
  03_copy_files:
    command: |
      mkdir -p /var/www/generalchatbot
      cp -r /var/app/staging/* /var/www/generalchatbot/
      chown -R webapp:webapp /var/www/generalchatbot
      chmod -R 755 /var/www/generalchatbot
    ignoreErrors: false 