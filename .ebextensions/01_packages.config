packages:
  yum:
    git: []
    nginx: []
    python3-devel: []
    gcc: []
    gcc-c++: []
    make: []

container_commands:
  01_install_nodejs:
    command: |
      curl -fsSL https://rpm.nodesource.com/setup_18.x | bash -
      yum install -y nodejs
    ignoreErrors: false
  02_install_pm2:
    command: npm install -g pm2
    ignoreErrors: false
  03_create_directories:
    command: |
      mkdir -p /var/www/generalchatbot
      mkdir -p /var/log/pm2
    ignoreErrors: false
  04_set_permissions:
    command: |
      chown -R webapp:webapp /var/www/generalchatbot
      chown -R webapp:webapp /var/log/pm2
    ignoreErrors: false 