container_commands:
  01_setup_backend:
    command: |
      cd /var/app/staging/Server
      python3 -m venv venv
      source venv/bin/activate
      pip install --upgrade pip
      pip install -r requirements.txt
    ignoreErrors: false
  02_build_frontend:
    command: |
      cd /var/app/staging/Frontend
      npm install --production=false
      npm run build
      ls -la dist/
    ignoreErrors: false 